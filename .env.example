# ═══════════════════════════════════════════════════════════════
# 节点伪装 + VLESS 流量代理 - 环境变量配置模板
# ═══════════════════════════════════════════════════════════════
# 用法：复制本文件为 .env，填入真实值，上传到容器 /home/container/
# 注意：本文件含敏感信息，切勿提交到 Git！.gitignore 已包含 .env
# ═══════════════════════════════════════════════════════════════

# ─── 必填 ──────────────────────────────────────────────────────
# VLESS/VMess UUID（节点流量鉴权）
# 生成：访问 https://uuidgenerator.org 或运行 uuidgen
UUID=0a6568ff-ea3c-4271-9020-450560e10d63

# 访问 Key（节点页 / 订阅页的密码，逗号分隔多个）
# ⚠️ 自己记一个，访问节点页时要用：https://ARGO_DOMAIN/node?key=KEY
KEYS=manggu2026,leleSecret99

# Cloudflare Argo 隧道配置
# 获取：https://one.dash.cloudflare.com/ → Networks → Tunnels → Create
ARGO_DOMAIN=node.your-domain.com
ARGO_AUTH=eyJhIjoi你的TunnelToken

# ─── Argo 隧道端口（sing-box 监听端口，与 Tunnel Service URL 一致）───
ARGO_PORT=8001

# ─── 节点显示名 ────────────────────────────────────────────────
NAME=Weirdhost-KR

# ─── 订阅路径 ──────────────────────────────────────────────────
SUB_PATH=sub

# ─── HTTP 服务端口 ─────────────────────────────────────────────
# Weirdhost：看「网络」标签页分配的端口
# HF Spaces：必须 7860
PORT=3000

# ─── CF 优选 IP/域名 ───────────────────────────────────────────
# ⭐ 推荐：用 Argo 域名作为 CFIP，最稳（CF 自动选最优 IP）
# CFIP=wei.gkc.ccwu.cc
#
# 或者用 CFST 测出的最快 IP（可能更快但会失效）
# 移动优选：104.16.155.78 / 172.67.74.226 / 188.114.96.1
# 电信优选：cf.090227.xyz
# 联通优选：saas.sin.fan
# 香港节点：icook.hk
CFIP=saas.sin.fan

# CF 优选端口（保持 443）
CFPORT=443

# ─── YouTube 走 WARP 出站（解锁地区限制）─────────────────────
YT_WARPOUT=false

# ─── 禁用 Argo 隧道（仅跑多协议直连）─────────────────────────
DISABLE_ARGO=false

# ─── 工作目录（保持默认）──────────────────────────────────────
FILE_PATH=.npm

# ─── 多协议端口（Weirdhost 单端口留空，只跑 VMess+Argo）─────
# 需要平台支持多端口暴露（如 Koyeb / VPS）才填
REALITY_PORT=
HY2_PORT=
TUIC_PORT=
ANYTLS_PORT=
ANYREALITY_PORT=
S5_PORT=

# ─── 哪吒探针（可选）──────────────────────────────────────────
NEZHA_SERVER=
NEZHA_PORT=
NEZHA_KEY=

# ─── Telegram 推送（可选）─────────────────────────────────────
CHAT_ID=
BOT_TOKEN=

# ─── 自动保活（HF Spaces / Render 免费版会休眠）──────────────
AUTO_ACCESS=false
PROJECT_URL=

# ─── Merge-sub 订阅器集成（可选）──────────────────────────────
UPLOAD_URL=
